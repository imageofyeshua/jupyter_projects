# ============================================================================
# Jupyter Notebook Specifics
# ============================================================================
# Ignore temporary autosave checkpoints generated by Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Ignore IPython configuration and history
.ipython/
profile_default/
ipython_config.py

# ============================================================================
# Python Environments & Cache
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (adjust names if you use different ones)
jupyter_env/
.venv/
env/
ENV/
.env

# ============================================================================
# Data & Large Files (Highly recommended for Data Science projects)
# ============================================================================
# Do not commit raw datasets or heavy formats to Git
*.csv
*.json
*.xlsx
*.parquet
*.pickle
*.pkl
*.h5

# ============================================================================
# Secret Management
# ============================================================================
# Never commit credentials or private API keys
.env
.secrets
