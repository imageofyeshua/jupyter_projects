   ],
   "source": [
    "xx = np.linspace(-3,3,51)\n",
    "X,Y = np.meshgrid(xx,xx)\n",
    "\n",
    "f1 = 4\n",
    "f2 = .8\n",
    "p1 = .6\n",
    "p2 = -.77\n",
    "\n",
    "Z = np.sin(f1*X*np.cos(f2*Y+p2)+p1)\n",
    "gx,gy = np.gradient(Z)\n",
    "\n",
    "plt.contourf(xx,xx,Z,40,cmap='coolwarm')\n",
    "plt.quiver(xx,xx,gx,gy)"
   ]
  },
